/**
 * @intent Forward cloud networks
 * @description VPC/VNet and subnet rows in one shape. VPC rows have an empty parent_id and kind=vpc; subnet rows carry their parent VPC. account_key and vpc_key are the parent identities, built from immutable provider ids so a rename never creates a second object.
 * @contract-version v3-infrahub
 */

cloud_vpcs() =
  foreach account in network.cloudAccounts
  foreach vpc in account.vpcs
  select {
    account_id: account.id,
    cloud_type: toLowerCase(replace(toString(account.cloudType), "CloudType.", "")),
    network_id: vpc.id,
    name: if isPresent(vpc.name) && vpc.name != "" then vpc.name else vpc.id,
    parent_id: "",
    kind: "vpc",
    cidrs: vpc.ipv4CidrBlocks
  };

cloud_subnets() =
  foreach account in network.cloudAccounts
  foreach vpc in account.vpcs
  foreach subnet in vpc.subnets
  select {
    account_id: account.id,
    cloud_type: toLowerCase(replace(toString(account.cloudType), "CloudType.", "")),
    network_id: subnet.id,
    name: if isPresent(subnet.name) && subnet.name != "" then subnet.name else subnet.id,
    parent_id: vpc.id,
    kind: "subnet",
    cidrs: subnet.addresses
  };

@primaryKey(cloud_type, account_id, network_id)
foreach row in ( cloud_vpcs() + cloud_subnets() )
let account_key = join("__", [row.cloud_type, row.account_id])
select {
  account_id: row.account_id,
  cloud_type: row.cloud_type,
  account_key: account_key,
  network_id: row.network_id,
  name: row.name,
  parent_id: row.parent_id,
  vpc_key: if row.parent_id != "" then join("__", [account_key, row.parent_id]) else "",
  kind: row.kind,
  cidrs: row.cidrs
}
