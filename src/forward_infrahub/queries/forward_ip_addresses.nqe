/**
 * @intent Forward IP addresses
 * @description IpamIPAddress rows from Forward interface L3 state, covering subinterface, bridge, tunnel and routed-VLAN attachment for both families. Addresses anchor to the parent interface, not the subinterface. namespace is the network instance; interface_key is the owning interface's identity; primary_of names the device when the address sits on a management or first loopback interface, which is how a device gets its primary address without a second pass.
 * @contract-version v3-infrahub
 */

// NQE has no startsWith, and substring past the end is safe, but the length
// guard keeps the comparison honest rather than relying on that.
hasPrefix(value: String, prefix: String) =
  length(value) >= length(prefix) && substring(value, 0, length(prefix)) == prefix;

// Which interface carries a device's primary address is a convention, not a
// fact Forward records, so this is a heuristic and is deliberately narrow:
// naming a wrong address primary is worse than naming none. Covers the long
// forms and the short ones (lo0, mgmt0) that real devices actually use.
// Split in two so the name is lower-cased once: a function body is a single
// expression here, with no let bindings to hold the result.
isPrimaryLowerName(lower: String) =
  lower == "lo0" || lower == "loopback0" || lower == "fxp0" ||
  hasPrefix(lower, "management") || hasPrefix(lower, "mgmt");

isPrimaryInterface(name: String) = isPrimaryLowerName(toLowerCase(name));

subinterface_ipv4() =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  foreach interface in device.interfaces
  foreach subinterface in interface.subinterfaces
  foreach address in subinterface.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    namespace: if isPresent(subinterface.networkInstanceName)
      then if subinterface.networkInstanceName != "default" then subinterface.networkInstanceName else "default"
      else "default",
    address: join("/", [toString(address.ip), toString(address.prefixLength)]),
    host_ip: address.ip,
    prefix_length: address.prefixLength
  };

subinterface_ipv6() =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  foreach interface in device.interfaces
  foreach subinterface in interface.subinterfaces
  foreach address in subinterface.ipv6.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 127 || address.ip != networkAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    namespace: if isPresent(subinterface.networkInstanceName)
      then if subinterface.networkInstanceName != "default" then subinterface.networkInstanceName else "default"
      else "default",
    address: join("/", [toString(address.ip), toString(address.prefixLength)]),
    host_ip: address.ip,
    prefix_length: address.prefixLength
  };

bridge_ipv4() =
  foreach device in network.devices
  where device.snapshotInfo.result == DeviceSnapshotResult.completed
  where device.platform.vendor != Vendor.FORWARD_CUSTOM
  foreach interface in device.interfaces
  where isPresent(interface.bridge?.ipv4?.addresses)
  foreach address in interface.bridge.ipv4.addresses
  let subnet = ipSubnet(address.ip, address.prefixLength)
  where address.prefixLength >= 31 || address.ip != networkAddress(subnet)
  where address.prefixLength >= 31 || address.ip != broadcastAddress(subnet)
  select {
    device: device.name,
    interface: interface.name,
    namespace: if isPresent(interface.bridge.networkInstanceName)
      then if interface.bridge.networkInstanceName != "default" then interface.bridge.networkInstanceName else "default"
      else "default",
    address: join("/", [toString(address.ip), toString(address.prefixLength)]),
    host_ip: address.ip,
    prefix_length: address.prefixLength
  };

